# This service does not auto-load .env: export these values through systemd,
# Docker or the invoking shell. HTTP port exposed to agents and collectors. Default: 5000.
PORT=5000

# Real minimum interval (ms) between actual reads of the machine source
# backing GET /current's Events/Samples blocks (see src/reader.ts's
# CachedReader) - a request within this window is served the cached
# reading instead of polling the source again. Default: 1000.
POLL_INTERVAL_MS=1000

# Real machine source (src/hydraServerReader.ts). Unset (the default), with
# no machine behind it, every DataItem is UNAVAILABLE. Set to a real
# HYDRA-UMC-SERVER base URL to report one real robot's own live
# AVAILABILITY/EXECUTION instead.
# HYDRA_UMC_SERVER_URL=http://localhost:3000

# HYDRA-UMC-SERVER only answers GET /api/settings to a logged-in account, so
# the real machine source needs a credential as well (only consulted when
# HYDRA_UMC_SERVER_URL is set). Either a token the server already issued...
# HYDRA_UMC_SERVER_TOKEN=paste-a-session-token
# ...or an account the adapter logs in with itself (and logs in with again
# when its session expires). The token wins when both are set.
# HYDRA_UMC_SERVER_USER=operator
# HYDRA_UMC_SERVER_PASSWORD=change-me

# Address the HTTP server listens on. Default: 0.0.0.0 (an MTConnect client on
# the network reaches it); 127.0.0.1 keeps it behind a local reverse proxy.
# Answer an MTConnectError with HTTP 400 (INVALID_REQUEST, OUT_OF_RANGE) or 404 (NO_DEVICE) instead of
# 200. Default: off (200, as before); the body is the same document either way.
# HYDRA_UMC_MTCONNECT_HTTP_ERRORS=1

# HYDRA_UMC_MTCONNECT_HOST=0.0.0.0

# Which real robot (by its own numeric id in HYDRA-UMC-SERVER's own
# GET /api/settings roster) to report - only consulted when
# HYDRA_UMC_SERVER_URL is set. Defaults to the first robot in the live
# roster.
# HYDRA_UMC_ROBOT_ID=1

# Synthetic demonstration values (execution READY, available, 140 F), for a
# demo or local development with no HYDRA-UMC-SERVER: only served when this is
# exactly "1" and no HYDRA_UMC_SERVER_URL is set. The device's description says
# DEMONSTRATION DATA, so nobody can mistake it for a machine.
# HYDRA_UMC_MTCONNECT_DEMO=1

# How many observations the agent keeps (the bufferSize it advertises). Default 10000.
# MTCONNECT_BUFFER_SIZE=10000

# Minimum milliseconds between real reads of the source (0 = every request) and
# the age in milliseconds after which a reading is reported UNAVAILABLE
# (0 = never). A value that is set but not a non-negative integer stops the start.
# POLL_INTERVAL_MS=1000
# MAX_SAMPLE_AGE_MS=0
