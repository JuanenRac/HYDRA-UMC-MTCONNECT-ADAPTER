# This service does not auto-load .env: export these values through systemd,
# Docker or the invoking shell. HTTP port exposed to agents and collectors. Default: 5000.
PORT=5000

# Real minimum interval (ms) between actual reads of the machine source
# backing GET /current's Events/Samples blocks (see src/reader.ts's
# CachedReader) - a request within this window is served the cached
# reading instead of polling the source again. Default: 1000.
POLL_INTERVAL_MS=1000

# Real machine source (src/hydraServerReader.ts). Unset (the default):
# this adapter reports FixtureMachineReader's own fixed, synthetic
# readings - fine for local development or a demo with no live
# HYDRA-UMC-SERVER reachable. Set to a real HYDRA-UMC-SERVER base URL to
# report one real robot's own live AVAILABILITY/EXECUTION instead.
# HYDRA_UMC_SERVER_URL=http://localhost:3000

# Which real robot (by its own numeric id in HYDRA-UMC-SERVER's own
# GET /api/settings roster) to report - only consulted when
# HYDRA_UMC_SERVER_URL is set. Defaults to the first robot in the live
# roster.
# HYDRA_UMC_ROBOT_ID=1
