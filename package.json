{
  "name": "hydra-umc-mtconnect-adapter",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Standardized MTConnect 1.7 XML/HTTP interface exposing the HYDRA-UMC robot swarm as monitorable machine tools.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "xmllint-wasm": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
